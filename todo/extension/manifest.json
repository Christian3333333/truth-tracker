{
  "manifest_version": 3,
  "name": "Truth Tracker",
  "version": "0.1.0",
  "description": "Verifica afirmaciones de reels de Instagram y muestra un informe en panel lateral.",
  "permissions": ["storage", "activeTab", "tabs", "tabCapture", "offscreen"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Truth Tracker"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["dist/content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
